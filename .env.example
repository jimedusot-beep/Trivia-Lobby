# Development database (required in all environments)
DATABASE_URL=postgresql://user:password@localhost:5432/trivia_lobby

# REQUIRED when NODE_ENV=production. Use unique random secrets: do not reuse app passwords.
# For example, generate a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
TRIVIA_LIBRARY_PASSWORD=replace-with-a-strong-family-password-at-least-16-characters
TRIVIA_SESSION_SECRET=replace-with-an-independent-random-secret-at-least-32-characters

# Hosting
PORT=5000
