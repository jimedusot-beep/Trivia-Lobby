DATABASE_URL=postgresql://trivia:change-me@127.0.0.1:5432/trivia
# Neon CLI creates both URLs. Use the second for migrations and pg_dump.
# DATABASE_URL_UNPOOLED=postgresql://trivia:change-me@host.neon.tech/trivia?sslmode=require
PORT=5000
# Choose a persistent private volume OR S3, outside the application tree.
PRIVATE_STORAGE_DIR=/srv/trivia-originals
# Neon free-storage option for Render Free (private bucket required):
# S3_BUCKET=trivia-originals
# AWS_REGION=us-east-1
# AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.REGION.aws.neon.tech
# S3_ENDPOINT=only-needed-for-a-different-existing-S3-provider
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=store-only-in-server-secrets
# AWS_SECRET_ACCESS_KEY=store-only-in-server-secrets
# S3_KMS_KEY_ID=your-kms-key-id
# Use workload credentials / AWS default credential chain; never Vite variables.
# AI Gateway only on a PAID Neon plan; disabled for $0 usage.
# ENABLE_PAID_NEON_AI_GATEWAY=false
# NEON_AI_GATEWAY_BASE_URL=https://YOUR-BRANCH-api.ai.REGION.aws.neon.tech
# NEON_AI_GATEWAY_TOKEN=server-secret-only
# NEON_AI_GATEWAY_MODEL=explicit-enabled-model-id
# STUDY_AI_ENDPOINT=https://your-provider.example/study-drafts
# STUDY_AI_API_KEY=configure-in-deployment-secret-store
# BACKUP_DIR=/srv/encrypted-trivia-backups

# Optional encrypted recovery archive; minimum 32 characters, kept outside Git.
BACKUP_PASSPHRASE=
# Optional private offsite destination for encrypted recovery archives.
BACKUP_S3_BUCKET=
# Independent destination only; AWS_* above still selects source storage.
# BACKUP_AWS_REGION=us-east-1
# BACKUP_AWS_ACCESS_KEY_ID=destination-key-in-secret-store
# BACKUP_AWS_SECRET_ACCESS_KEY=destination-secret-in-secret-store
# BACKUP_AWS_SESSION_TOKEN=only-for-temporary-destination-credentials
# BACKUP_S3_ENDPOINT=https://independent-s3-compatible-provider.example
# BACKUP_S3_FORCE_PATH_STYLE=true
# Require a verified upload as well as a local archive (scheduled jobs set this).
# BACKUP_REQUIRE_OFFSITE=1

# Restore requires an existing empty local directory, separate from source storage.
# RESTORE_PRIVATE_STORAGE_DIR=/srv/isolated-trivia-restore
