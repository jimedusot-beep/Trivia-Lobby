DATABASE_URL=postgresql://trivia:change-me@127.0.0.1:5432/trivia
PORT=5000
# Choose a persistent private volume OR S3, outside the application tree.
PRIVATE_STORAGE_DIR=/srv/trivia-originals
# S3_BUCKET=private-trivia-originals
# AWS_REGION=us-east-1
# S3_ENDPOINT=https://your-s3-compatible-provider.example
# S3_FORCE_PATH_STYLE=true
# S3_KMS_KEY_ID=your-kms-key-id
# Use workload credentials / AWS default credential chain; never Vite variables.
# STUDY_AI_ENDPOINT=https://your-provider.example/study-drafts
# STUDY_AI_API_KEY=configure-in-deployment-secret-store
# BACKUP_DIR=/srv/encrypted-trivia-backups

# Optional encrypted recovery archive; minimum 32 characters, kept outside Git.
BACKUP_PASSPHRASE=
# Optional private offsite destination for encrypted recovery archives.
BACKUP_S3_BUCKET=
