{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --import tsx server/index.ts",
    "build": "node --import tsx script/build.ts",
    "start": "node dist/start.mjs",
    "check": "tsc",
    "test": "node --import tsx --test client/src/lib/*.test.ts server/library-parse.test.ts server/study-scheduler.test.ts server/study-security.test.ts server/bounded-response.test.ts server/backup-crypto.test.ts server/backup-offsite.test.ts server/restore-storage.test.ts server/neon-storage.test.ts server/neon-services.test.ts tests/phase1-multiplayer.test.ts tests/odd-one-out.test.ts tests/room-projections.test.ts tests/universal-questions.test.ts tests/platform-unit.test.ts tests/research-manifest.test.mjs tests/room-checkpoints.test.ts tests/party-recovery.test.ts tests/live-recovery.test.ts",
    "db:push": "drizzle-kit push",
    "test:integration": "node --import tsx --test --test-force-exit tests/private-library.integration.test.ts tests/universal-questions-db.test.ts tests/phase1-postgres.test.ts server/study-api.test.ts tests/platform.integration.test.ts tests/game-reports.integration.test.ts tests/assignments.integration.test.ts tests/room-checkpoints.integration.test.ts",
    "db:migrate:phase3": "node --import tsx script/migrate-phase3.ts",
    "db:migrate": "node --import tsx script/migrate.ts",
    "test:e2e": "playwright test",
    "test:production": "node --test tests/production-start.test.mjs",
    "smoke": "node --import tsx script/smoke.ts",
    "backup:db": "bash script/backup-db.sh",
    "restore:db": "bash script/restore-db.sh",
    "audit:licenses": "node --import tsx script/license-audit.ts",
    "backup:encrypted": "node --import tsx script/backup.ts",
    "backup:drill": "node --import tsx --test --test-force-exit tests/recovery/backup-restore.ts",
    "dev:neon": "node --env-file=.env.local --import tsx server/index.ts",
    "verify:neon": "node --env-file=.env.local --import tsx script/verify-neon-services.ts",
    "start:neon": "node --env-file=.env.local dist/start.mjs",
    "test:neon": "node --import tsx --test server/neon-services.test.ts"
  },
